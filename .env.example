# Copy to .env next to the server. Bun loads it on start.
# Every other setting is stored in the database and edited under Admin, Settings.

# Required. Encrypts payment credentials, secret settings and files stored in S3.
# Generate with: openssl rand -base64 48 and keep a copy outside the server.
RABBITPAY_MASTER_KEY=""

# Database connection string. Defaults to sqlite://./data/rabbitpay.sqlite
# RABBITPAY_DB="postgres://user:pass@localhost/rabbitpay"

DOCUMENT_STORAGE="local"
DOCUMENT_LOCAL_PATH="./data/invoices"
DOCUMENT_S3_BUCKET=""
DOCUMENT_S3_REGION=""
DOCUMENT_S3_ENDPOINT=""
DOCUMENT_S3_ACCESS_KEY_ID=""
DOCUMENT_S3_SECRET_ACCESS_KEY=""
DOCUMENT_S3_SESSION_TOKEN=""

# Background threads that render PDFs. Defaults to a quarter of the CPU threads, between 1 and 4.
# RABBITPAY_RENDER_WORKERS="4"

# Only on the server that issues license keys. Generate with: bun run license:keygen
# RABBITPAY_LICENSE_SIGNING_KEY=""
